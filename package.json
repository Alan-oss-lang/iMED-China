{
  "name": "imed-china",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/local.mjs",
    "start": "node --env-file-if-exists=.env.local server/local.mjs",
    "setup": "node scripts/setup-local.mjs",
    "build": "node scripts/build.mjs",
    "import:legacy": "node scripts/import-legacy.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:netlify": "node scripts/check-netlify.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.3",
    "cheerio": "1.1.2",
    "sanitize-html": "2.18.0"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^16.3.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
